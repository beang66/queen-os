// Queen-OS 데이터 계층. PostgreSQL(Supabase)로 운영 중. SQLite로 되돌리려면 provider/url만 교체합니다.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// 시스템 사용자. 계정은 관리자만 만들 수 있고, 자유 가입 경로는 없습니다.
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  /// ADMIN(관리자) | ESTIMATOR(견적담당) | VIEWER(조회전용)
  role         String  @default("ESTIMATOR")
  /// scrypt 해시. 원문 비밀번호는 어디에도 저장하지 않습니다.
  passwordHash String  @map("password_hash")
  /// ACTIVE | DISABLED — 비활성 계정은 로그인도, 기존 세션 유지도 되지 않습니다.
  status       String  @default("ACTIVE")
  /// 관리자가 만든 초기 비밀번호를 아직 안 바꿨는지
  mustChangePassword Boolean @default(true) @map("must_change_password")
  lastLoginAt  DateTime? @map("last_login_at")

  sessions  Session[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("app_user")
}

/// 로그인 세션. 쿠키에는 원문 토큰이, DB 에는 그 해시만 저장됩니다.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("app_session")
}

model PricingItem {
  id           String   @id @default(cuid())
  code         String   @unique
  category     String   // CARCASS | DOOR | COUNTERTOP | HARDWARE | APPLIANCE | LABOR | ACCESSORY
  name         String
  spec         String
  material     String
  unit         String
  costPrice    Int      @map("cost_price")    // 매입원가 (원, VAT 별도)
  sellingPrice Int      @map("selling_price") // 출고단가 (원, VAT 별도)
  supplier     String
  stockStatus  String   @default("INSTOCK") @map("stock_status")
  notes        String?
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("pricing_item")
}

model Quote {
  id               String   @id @default(cuid())
  quoteNumber      String   @unique @map("quote_number") // QN-20260908-001, -V2, -V3
  title            String
  status           String   @default("ISSUED")
  version          Int      @default(1)
  parentQuoteId    String?  @map("parent_quote_id")
  targetMarginRate Float    @map("target_margin_rate")

  orderEntity            Json    @map("order_entity")             // OrderEntity
  calculationResult      Json    @map("calculation_result")       // QuoteCalculationResult — 발행 시점 스냅샷
  publishMeta            Json?   @map("publish_meta")             // QuotePublishMeta
  appliedPricingSnapshot Json?   @map("applied_pricing_snapshot") // PricingItem[] (호환용)
  companyInfo            Json    @map("company_info")             // { name, representative, bizNumber, address, phone, email }
  notes                  String?

  draftId   String?  @map("draft_id")
  draft     Draft?   @relation(fields: [draftId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("quote")
}

model Draft {
  id       String @id @default(cuid())
  status   String @default("ACTIVE") // ACTIVE | PUBLISHED | ARCHIVED
  revision Int    @default(1)        // 낙관적 잠금 카운터
  payload  Json                      // DraftPayload — 현재 상태만 (이력은 아래 테이블로)

  // 목록 조회를 payload 파싱 없이 처리하기 위한 비정규화 컬럼
  customerName       String  @default("") @map("customer_name")
  projectName        String  @default("") @map("project_name")
  step               Int     @default(1)
  totalAmount        Int?    @map("total_amount")

  pricingFingerprint String? @map("pricing_fingerprint")
  lastEditorId       String? @map("last_editor_id")
  publishedQuoteIds  Json    @default("[]") @map("published_quote_ids")

  revisions QuoteDraftRevision[]
  quotes    Quote[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, updatedAt])
  @@map("draft")
}

/// AI 파싱 1회 = 1행. 파싱 시점에 만들어지고, 사람이 값을 확정하면
/// confirmed* 컬럼이 채워집니다. 확정 전 행(confirmedAt = null)은 통계 분모에서 빠집니다.
model AiParseLog {
  id   String @id @default(cuid())
  kind String // ORDER | DOCUMENT

  // ---- 파싱 시점 기록 -------------------------------------------------
  engine       String // GEMINI | HEURISTIC (Gemini 실패 시 규칙 기반 폴백)
  model        String  @default("")
  latencyMs    Int     @default(0) @map("latency_ms")
  promptChars  Int     @default(0) @map("prompt_chars")
  hasAttachment Boolean @default(false) @map("has_attachment")
  errorMessage String? @map("error_message") // Gemini 호출 실패 사유 (폴백 원인)
  itemCount    Int?    @map("item_count")    // DOCUMENT 파싱에서 추출된 품목 수
  parsedSnapshot Json  @map("parsed_snapshot") // AI 가 내놓은 원본 결과

  // ---- 사람이 확정한 뒤 기록 (수정률) ---------------------------------
  confirmedSnapshot Json?     @map("confirmed_snapshot")
  confirmStage      String?   @map("confirm_stage") // REVIEW | PUBLISH
  trackedCount      Int?      @map("tracked_count")
  matchedCount      Int?      @map("matched_count")
  correctedCount    Int?      @map("corrected_count")
  missingCount      Int?      @map("missing_count")
  correctionRate    Float?    @map("correction_rate")
  accuracyRate      Float?    @map("accuracy_rate")
  fieldDiffs        Json?     @map("field_diffs") // FieldDiff[] — 어떤 필드를 어떻게 고쳤는지
  confirmedAt       DateTime? @map("confirmed_at")

  draftId   String?  @map("draft_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([kind, createdAt])
  @@index([confirmedAt])
  @@map("ai_parse_log")
}

model QuoteDraftRevision {
  id       BigInt   @id @default(autoincrement())
  draftId  String   @map("draft_id")
  draft    Draft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  revision Int
  label    String   // 자동 저장 | 수동 임시 저장 | 단계 이동
  payload  Json     // DraftPayload. appliedPricingSnapshot 제외 — 용량 절감
  savedAt  DateTime @default(now()) @map("saved_at")

  @@unique([draftId, revision])
  @@index([draftId, savedAt])
  @@map("quote_draft_revision")
}
